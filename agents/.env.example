# 🤖 Coder1 Automation System - Environment Variables
# Copy this to .env and fill in your values

# ============================================================================
# REQUIRED API KEYS
# ============================================================================

# Claude AI API Key (Required for all content generation)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# GitHub Personal Access Token (Required for GitHub integration)
# Required permissions: repo, read:org
GITHUB_TOKEN=ghp_your-token-here

# ============================================================================
# GITHUB CONFIGURATION
# ============================================================================

GITHUB_OWNER=MichaelrKraft
GITHUB_REPO=coder1-ide

# ============================================================================
# OPTIONAL API KEYS
# ============================================================================

# SendGrid API Key (Optional - for email notifications)
SENDGRID_API_KEY=SG.your_key_here

# Medium API Key (Optional - for blog publishing)
MEDIUM_API_KEY=your_medium_key_here

# ============================================================================
# ALTERNATIVE EMAIL CONFIGURATION (If not using SendGrid)
# ============================================================================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email to send approval requests to
APPROVAL_EMAIL=support@callspot.ai

# ============================================================================
# AUTOMATION SETTINGS (Optional - has defaults)
# ============================================================================

# Content Generation
BLOG_POSTS_PER_WEEK=5
YOUTUBE_SCRIPTS_PER_WEEK=2
CASE_STUDIES_PER_WEEK=1

# Growth Automation
DAILY_STAR_LIMIT=5
MIN_RELEVANCE_SCORE=60

# Approval System
AUTO_APPROVE_THRESHOLD=0.95
TIMEOUT_HOURS_HIGH=0.5
TIMEOUT_HOURS_MEDIUM=2
TIMEOUT_HOURS_LOW=24

# Claude Model Selection
# Options: claude-3-haiku-20240307 (cheap), claude-3-5-sonnet-20241022 (better)
CLAUDE_MODEL=claude-3-haiku-20240307

# ============================================================================
# NOTES
# ============================================================================
# - Minimum required: ANTHROPIC_API_KEY and GITHUB_TOKEN
# - All other keys are optional (system falls back gracefully)
# - Don't commit .env file to Git
# - Use GitHub Secrets for automation
# - Monthly cost: ~$10-20 (mostly Claude API)