{
  "manifest_version": 3,
  "name": "Coder1 Component Capture",
  "version": "2.0.0",
  "description": "Capture any web component with full CSS (animations, gradients, hover states) in Coder1 IDE",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*",
    "http://localhost:3002/*",
    "http://127.0.0.1:3001/*",
    "http://127.0.0.1:3002/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-simple.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}