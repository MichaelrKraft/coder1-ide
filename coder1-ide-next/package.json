{
  "name": "coder1-ide-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' node server.js",
    "dev:custom": "node server.js",
    "dev:legacy": "next dev",
    "dev:unified": "node server.js",
    "cron-worker": "tsx worker/johnny5-cron-worker.ts",
    "dev:alpha": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=400' ALPHA_MODE_ENABLED=true ALPHA_INVITE_CODE=CODER1ALPHA2025 MAX_ALPHA_USERS=5 DEPLOYMENT_MODE=alpha-limited node server.js",
    "prebuild": "[ ! -d node_modules ] && npm install || echo 'Dependencies already installed'",
    "copy-canonical": "cp ../CANONICAL/*.html public/ 2>/dev/null || true",
    "build": "next build",
    "build:github-pages": "GITHUB_PAGES=true NODE_ENV=production next build",
    "build:render": "curl -fsSL https://claude.ai/install.sh | bash && export PATH=\"$HOME/.local/bin:$PATH\" && claude --version && npm install --legacy-peer-deps && npm rebuild node-pty --update-binary && next build",
    "build:unified": "NEXT_CONFIG_FILE=next.config.unified.js next build --experimental-build-mode=experimental-compile",
    "build:alpha": "npm run build",
    "build:standalone": "next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "PATH=\"$HOME/.local/bin:$PATH\" NODE_ENV=production node server.js",
    "start:alpha": "NODE_OPTIONS='--max-old-space-size=400 --expose-gc' NODE_ENV=production node server.js",
    "start:legacy": "next start",
    "start:unified": "NODE_ENV=production node server.js",
    "test:memory": "NODE_OPTIONS='--max-old-space-size=400 --expose-gc' node server.js",
    "lint": "next lint",
    "backfill:embeddings": "node scripts/backfill-embeddings.js",
    "db:migrate": "npx tsx db/migrations/run-migrations.ts migrate",
    "db:verify": "npx tsx db/migrations/run-migrations.ts verify",
    "db:history": "npx tsx db/migrations/run-migrations.ts history",
    "db:check": "npm run db:verify",
    "test:prd-tools": "npx tsx scripts/test-prd-tools.ts",
    "skills:enable": "node -e \"const fs=require('fs');const path='.env.local';let content=fs.existsSync(path)?fs.readFileSync(path,'utf8'):'';content=content.replace(/ENABLE_SKILLS_SYSTEM=.*/g,'').trim();content+='\\nENABLE_SKILLS_SYSTEM=true\\n';fs.writeFileSync(path,content);console.log('✅ Skills System ENABLED');console.log('   Restart server: npm run dev');\"",
    "skills:disable": "node -e \"const fs=require('fs');const path='.env.local';let content=fs.existsSync(path)?fs.readFileSync(path,'utf8'):'';content=content.replace(/ENABLE_SKILLS_SYSTEM=.*/g,'').trim();content+='\\nENABLE_SKILLS_SYSTEM=false\\n';fs.writeFileSync(path,content);console.log('⚠️  Skills System DISABLED');console.log('   Restart server: npm run dev');\"",
    "skills:status": "node -e \"const fs=require('fs');const path='.env.local';if(!fs.existsSync(path)){console.log('❌ .env.local not found - Skills System is DISABLED (default)');process.exit(0);}const content=fs.readFileSync(path,'utf8');const match=content.match(/ENABLE_SKILLS_SYSTEM=(true|false)/);if(!match){console.log('⚠️  ENABLE_SKILLS_SYSTEM not set - Skills System is DISABLED (default)');}else if(match[1]==='true'){console.log('✅ Skills System is ENABLED');console.log('   Expected: 80-90% token reduction');console.log('   Expected: 5-6x faster responses');}else{console.log('❌ Skills System is DISABLED');console.log('   Using legacy implementations');}\"",
    "load:install": "npm install --save-dev artillery artillery-engine-socketio-v3",
    "load:session": "npx artillery run load-tests/session-stress.yml",
    "load:agent": "npx artillery run load-tests/agent-spawn.yml",
    "load:soak": "npx artillery run load-tests/memory-soak.yml",
    "load:all": "npm run load:session && npm run load:agent",
    "load:report": "npx artillery run --output load-tests/report.json load-tests/session-stress.yml && npx artillery report load-tests/report.json",
    "load:quick": "npx artillery quick --count 10 -n 5 http://localhost:3001/api/health",
    "postinstall": "npm rebuild node-pty better-sqlite3 --build-from-source && node scripts/setup-manuslive.js",
    "setup:manuslive": "node scripts/setup-manuslive.js"
  },
