# Coder1 IDE Environment Variables
# Copy this file to .env.local and update with your values

# ====== Core Configuration ======
# Node environment (development, production, test)
# Format: see validation
NODE_ENV=development

# Server port number (1-65535)
# Format: see validation
PORT=3001

# User workspace directory (for file explorer security)
# Users can browse any projects within this directory
# Changed to allow full project navigation while protecting source code
USER_WORKSPACE_PATH=user-workspaces


# ====== Claude CLI Integration ======
# Custom path to Claude CLI executable (auto-detected if not set)
# Leave empty for automatic detection
CLAUDE_CLI_PATH=


# ====== Database ======
# Database connection string
DATABASE_URL=sqlite://./data/coder1.db

# JWT secret for authentication (min 32 chars)
# Format: see validation
JWT_SECRET=your-secret-here


# ====== Authentication ======
# NextAuth secret for session management
# Format: see validation
NEXTAUTH_SECRET=your-secret-here

# NextAuth callback URL
NEXTAUTH_URL=http://localhost:3001


# ====== Token Encryption ======
# AES-256-GCM encryption key for OAuth tokens at rest (64-char hex string = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ====== Feature Flags ======
# Enable AI supervision in terminal
# Format: see validation
ENABLE_SUPERVISION=true

# Enable session summary feature
# Format: see validation
ENABLE_SESSION_SUMMARY=true

# Enable container/sandbox features
# Format: see validation
ENABLE_CONTAINERS=false

# Enable team collaboration features (disabled for alpha, enable for beta)
# Set to 'true' to show team UI: FloatingTeamButton, Teams tab, Agent Teams
NEXT_PUBLIC_ENABLE_TEAM_FEATURES=false

# Agent Hub feature flag (Phase 0)
NEXT_PUBLIC_ENABLE_AGENT_HUB=false

# VCS Integration feature flags (Phase 0A-4)
NEXT_PUBLIC_VCS_UI_ENABLED=false
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=false
NEXT_PUBLIC_PR_DASHBOARD_ENABLED=false
NEXT_PUBLIC_CONFLICT_DETECTION_ENABLED=false
NEXT_PUBLIC_REVIEW_ROUTING_ENABLED=false
NEXT_PUBLIC_JOHNNY5_VCS_CONTEXT_ENABLED=false


# ====== OAuth Providers ======
# GitHub OAuth client ID
GITHUB_CLIENT_ID=

# GitHub OAuth client secret
GITHUB_CLIENT_SECRET=your-secret-here

# Google OAuth client ID
GOOGLE_CLIENT_ID=

# Google OAuth client secret
GOOGLE_CLIENT_SECRET=your-secret-here


# ====== Performance & Limits ======
# Maximum file size in bytes
# Format: see validation
MAX_FILE_SIZE=10485760

# Request timeout in milliseconds
# Format: see validation
REQUEST_TIMEOUT=30000

# Maximum concurrent terminal sessions
# Format: see validation
MAX_TERMINAL_SESSIONS=10


# ====== Payment & Subscriptions ======
# Stripe public key for client-side (starts with pk_live_ or pk_test_)
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_YOUR_PUBLIC_KEY_HERE

# Premium API server URL (where billing service runs)
NEXT_PUBLIC_PREMIUM_API_URL=http://localhost:3003

# Enable memory trial system
ENABLE_MEMORY_TRIAL=true

# Memory trial duration in days (alpha users get 30 days)
MEMORY_TRIAL_DAYS=30


# ====== GitHub Pages Deployment ======
# Set to true for GitHub Pages static build
GITHUB_PAGES=false

# GitHub repository name for Pages
GITHUB_REPO=coder1-ide

# ============================================
# Alpha Feedback Email Notifications
# ============================================
# Get your FREE Resend API key from: https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100 emails/day
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=your@email.com
FEEDBACK_EMAIL_FROM=Coder1 Feedback <feedback@yourdomain.com>

# ============================================
# Composio Integration (Deployment Assistant)
# ============================================
# Enables OAuth connections to deployment platforms (Render, Vercel, Supabase)
# Sign up at: https://app.composio.dev
# Get API key from: Settings → API Keys
#
# After getting your key:
# 1. Set COMPOSIO_API_KEY below
# 2. In Composio dashboard, go to Apps → Render → Configure OAuth
# 3. Set redirect URI to your app's callback URL

# Composio API Key (REQUIRED for Deployment Assistant)
COMPOSIO_API_KEY=

# Optional: Explicit encryption key for OAuth tokens
# If not set, derived from COMPOSIO_API_KEY (secure default)
# COMPOSIO_ENCRYPTION_KEY=

# Flight Recorder - Session recording for replay
NEXT_PUBLIC_FLIGHT_RECORDER_ENABLED=true

# ====== Johnny5 Living Files ======
# Enable the living files architecture for Johnny5 (OpenClaw-style)
# When true: Johnny5 uses 9 .md files on disk for context, memory, and identity
# When false (default): Johnny5 uses the legacy database-centric memory system
# Set to 'true' to activate living files after running the migration script
JOHNNY5_LIVING_FILES=false

# ====== TikTok Content Automation (Johnny5) ======
# Enable TikTok content generation feature
JOHNNY5_TIKTOK_ENABLED=false

# Daily budget limit for image generation (USD)
TIKTOK_DAILY_BUDGET=5.00

# Postiz API (for posting to TikTok)
# Get API key from: https://postiz.com
POSTIZ_API_KEY=
POSTIZ_TIKTOK_INTEGRATION_ID=
