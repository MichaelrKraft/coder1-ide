{
  "name": "coder1-bridge",
  "version": "1.1.1",
  "description": "Bridge service to connect Coder1 IDE with local Claude CLI",
  "main": "src/index.js",
  "bin": {
    "coder1-bridge": "./bin/coder1-bridge"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js --dev",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "pkg . --out-path dist",
    "build:macos-arm64": "pkg . --target node20-macos-arm64 --output dist/coder1-bridge-macos-arm64",
    "build:macos-x64": "pkg . --target node20-macos-x64 --output dist/coder1-bridge-macos-x64",
    "build:linux": "pkg . --target node20-linux-x64 --output dist/coder1-bridge-linux",
    "build:windows": "pkg . --target node20-win-x64 --output dist/coder1-bridge-win.exe"
  },
  "keywords": [
    "coder1",
    "claude",
    "cli",
    "bridge",
    "ide"
  ],
  "author": "Coder1 Team",
  "license": "MIT",
  "dependencies": {
    "socket.io-client": "^4.8.1",
    "p-queue": "5.0.0",
    "winston": "^3.11.0",
    "commander": "^11.1.0",
    "node-fetch": "^2.7.0"
  },
  "optionalDependencies": {
    "node-pty-prebuilt-multiarch": "^0.10.1"
  },
  "bundledDependencies": [
    "node-fetch"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "preferGlobal": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelrKraft/coder1-ide.git"
  },
  "homepage": "https://coder1.ai",
  "bugs": {
    "url": "https://github.com/MichaelrKraft/coder1-ide/issues"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "README.md",
      "package.json"
    ],
    "targets": [
      "node20-macos-arm64",
      "node20-macos-x64",
      "node20-linux-x64",
      "node20-win-x64"
    ],
    "outputPath": "dist"
  }
}
