# ============================================
# CODER1 IDE - UNIFIED SERVER ARCHITECTURE ✨
# ============================================
# SIMPLIFIED: Single unified server handles everything!
# 
# UNIFIED NEXT.JS CUSTOM SERVER (Port 3001):
#    ✅ Next.js UI (the IDE interface)
#    ✅ Terminal PTY (integrated terminal functionality) 
#    ✅ WebSocket via Socket.IO
#    ✅ File operations API
#    ✅ Context Folders API
#    ✅ StatusBar with Brain icon
#    ✅ Session management
#    ✅ Enhanced tmux integration ready
#
# ⚠️ IMPORTANT: Always start with:
#    npm run dev
#
# DO NOT USE: npm run dev:legacy (no terminal support)
#
# ACCESS THE IDE AT: http://localhost:3001/ide
#
# TROUBLESHOOTING:
#   - CSS not loading? You're using legacy mode
#   - Terminal shows "Connection lost"? You're using legacy mode
#   - Solution: Use "npm run dev" (unified mode is now default)
#   - See DEVELOPMENT.md for complete guide
# ============================================

# Unified Server Configuration (Single port for everything!)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_UNIFIED_SERVER_URL=http://localhost:3001
PORT=3001

# WebSocket Connection (Same server via Socket.IO)
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3001

# ============================================
# Claude CLI Integration - NO API KEYS NEEDED!
# ============================================
# Install Claude Code CLI from https://claude.ai/code
# The system will auto-detect the CLI location
# Only set this if Claude CLI is in a custom location
CLAUDE_CLI_PATH=

# Memory persistence database location
DATABASE_URL=sqlite://./data/coder1-memory.db

# ============================================
# Authentication & OAuth
# ============================================
# Google OAuth
# Get these from https://console.cloud.google.com/
# 1. Create a new project or select existing
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URI: http://localhost:3001/api/v2/auth/google/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Secrets (generate random strings)
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here

# ============================================
# Feature Flags
# ============================================
NEXT_PUBLIC_ENABLE_AI_CONSULTATION=true
NEXT_PUBLIC_ENABLE_AGENT_DASHBOARD=true
NEXT_PUBLIC_ENABLE_TWEAKCC=false
NEXT_PUBLIC_ENABLE_CONTAINERS=false

# Memory Context System (Automatic context from previous sessions)
NEXT_PUBLIC_MEMORY_CONTEXT_ENABLED=true
NEXT_PUBLIC_MEMORY_AUTO_INJECT=true

# ============================================
# Claude CLI Puppeteer (TRUE Agent Automation) 🎭
# ============================================
# Enables real AI agent automation using Claude CLI instances
# Set to true to enable cost-free multi-agent parallel execution
ENABLE_CLI_PUPPETEER=false

# Claude CLI binary path (auto-detected if not specified)
CLAUDE_CLI_PATH=

# Agent execution limits
MAX_PARALLEL_AGENTS=5
MAX_WORKFLOW_TIME=600000

# Agent behavior settings  
AGENT_RESPONSE_TIMEOUT=30000
AGENT_SETUP_TIMEOUT=10000
AGENT_IDLE_TIMEOUT=300000

# Work tree configuration for git isolation
ENABLE_WORK_TREES=true
WORK_TREE_BASE_DIR=./agent-workspaces

# Debug and logging
CLI_PUPPETEER_DEBUG=false
CLI_PUPPETEER_LOG_LEVEL=info

# Interactive mode for file system tools (experimental)
# WARNING: Enable only for testing - changes agent behavior significantly
ENABLE_INTERACTIVE_CLI=false

# ============================================
# Development Settings
# ============================================
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ============================================
# Beta Multi-AI Platform Support 🚀
# ============================================
# Enable Beta route with multi-AI features
NEXT_PUBLIC_ENABLE_BETA_ROUTE=false

# Multi-AI Platform Detection
ENABLE_MULTI_AI_DETECTION=false
AI_PLATFORM_CACHE_DURATION=300000

# Supported AI CLI Platforms (comma-separated)
# Options: claude,openai,github-copilot,aider,continue,codeium,cursor,ollama
ENABLED_AI_PLATFORMS=claude,openai,github-copilot,aider

# Default AI Platform (if multiple are available)
DEFAULT_AI_PLATFORM=claude

# Universal AI Memory Layer
ENABLE_UNIVERSAL_MEMORY=false
MAX_MEMORY_CONTEXT_TOKENS=2000
MEMORY_RETENTION_DAYS=30

# AI Platform API Keys (for platforms that need them)
# Note: Some CLIs use their own auth (e.g., gh auth login for GitHub Copilot)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================
# GLM API Integration (智谱AI) 🚀
# ============================================
# Get your API key from: https://open.bigmodel.cn/
# GLM provides cost-effective AI models as fallback when Claude hits rate limits
# Models: glm-4-flash ($0.10/M tokens), glm-4-air ($1/M), glm-4-plus ($50/M)

# GLM API Key (REQUIRED for GLM features)
GLM_API_KEY=
NEXT_PUBLIC_GLM_API_KEY=

# GLM Cost Tracking
ENABLE_GLM_COST_DISPLAY=true
GLM_COST_PER_MILLION_TOKENS=0.10

# Rate Limit Fallback Settings
ENABLE_RATE_LIMIT_FALLBACK=true
AUTO_SWITCH_BACK_TO_CLAUDE=true
RATE_LIMIT_COOLDOWN_MINUTES=15

# Context Preservation
MAX_CONTEXT_LINES_FOR_GLM=200
ENABLE_CONTEXT_PRESERVATION=true

# ============================================
# Z.AI GLM 4.6 Backend (Overflow Capacity) 🔄
# ============================================
# For Claude Code Pro users who hit rate limits frequently
# Get API key from: https://z.ai (智谱AI reseller)
# Cost: $0.10/M tokens (10x cheaper than Claude)
# Quality: Comparable to Claude Sonnet 4.5

# Enable GLM backend (set to true when configured)
USE_GLM_BACKEND=false

# Z.AI API Credentials
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/anthropic

# ⚙️ How to Use:
# 1. Sign up at https://z.ai and get API key
# 2. Add key above and set USE_GLM_BACKEND=true
# 3. Restart IDE: npm run dev
# 4. Open Terminal Settings → Select "GLM 4.6"
# 5. Use Claude Code normally - runs on GLM at $0.10/M

# ============================================
# GEMINI API (Google) 🚀 NO PASSPORT REQUIRED!
# ============================================
# Google Gemini provides ultra-cheap AI models - RECOMMENDED ALTERNATIVE to GLM
# NO PASSPORT/ID verification required - just Google account!
# Get API key: https://ai.google.dev/ (FREE tier available!)
# Model: gemini-2.5-flash-lite ($0.10/M input, $0.40/M output)

# Gemini API Key (RECOMMENDED - No passport needed!)
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# Gemini Cost Tracking
ENABLE_GEMINI_COST_DISPLAY=true
GEMINI_COST_PER_MILLION_TOKENS_FLASH_LITE_INPUT=0.10
GEMINI_COST_PER_MILLION_TOKENS_FLASH_LITE_OUTPUT=0.40

# Local AI Support (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=codellama

# Smart Context Injection
ENABLE_SMART_CONTEXT=true
CONTEXT_RELEVANCE_THRESHOLD=0.7
MAX_CONTEXT_CHUNKS=3

# AI Arbitrage Settings (route to cheapest capable model)
ENABLE_AI_ARBITRAGE=false
COST_OPTIMIZATION_LEVEL=balanced

# Beta Features Analytics
ENABLE_BETA_ANALYTICS=false
BETA_ANALYTICS_ENDPOINT=

# ============================================
# Go High Level CRM Integration 🚀
# ============================================
# GHL provides professional CRM, email automation, and customer tracking
# Get your API credentials from your GHL account settings
# Documentation: https://developers.gohighlevel.com/

# GHL API Authentication
GHL_API_KEY=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_LOCATION_ID=

# GHL Webhook Configuration
# Set this in GHL webhook settings: http://localhost:3001/api/webhooks/ghl
GHL_WEBHOOK_SECRET=

# GHL Environment (production or sandbox)
GHL_ENVIRONMENT=production

# Feature Flags for GHL Integration
ENABLE_GHL_INTEGRATION=false
ENABLE_GHL_AUTO_SYNC=true
ENABLE_GHL_WEBHOOKS=true
ENABLE_GHL_EMAIL_CAMPAIGNS=true

# GHL Sync Settings
GHL_SYNC_INTERVAL_MS=300000
GHL_BATCH_SIZE=50
GHL_RETRY_ATTEMPTS=3

# GHL Custom Field IDs (map these to your GHL custom fields)
# These will be created if they don't exist
GHL_FIELD_USER_ID=
GHL_FIELD_SUBSCRIPTION_TIER=
GHL_FIELD_LAST_PROJECT=
GHL_FIELD_TOTAL_PROJECTS=
GHL_FIELD_AI_USAGE=
GHL_FIELD_LAST_ACTIVE=