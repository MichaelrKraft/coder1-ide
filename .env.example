# Coder1 IDE - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ==============================================================================
# PRODUCTION DEPLOYMENT CONFIGURATION
# ==============================================================================

# Server Configuration
NODE_ENV=production
PORT=3001

# Public URLs (Update these for your Render deployment)
NEXT_PUBLIC_API_URL=https://your-app-name.onrender.com
NEXT_PUBLIC_UNIFIED_SERVER_URL=https://your-app-name.onrender.com
NEXT_PUBLIC_WEBSOCKET_URL=wss://your-app-name.onrender.com

# Database Configuration
DATABASE_URL=sqlite://./data/coder1-memory.db

# Security - REQUIRED for production
JWT_SECRET=your-secure-random-jwt-secret-256-bits
JWT_REFRESH_SECRET=your-secure-random-refresh-secret-256-bits

# ==============================================================================
# AI SERVICES (Optional - for enhanced features)
# ==============================================================================

# Claude API (Anthropic) - For AI features
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API - For fallback AI features
OPENAI_API_KEY=sk-your-openai-key-here

# ==============================================================================
# AUTHENTICATION (Optional - for Google OAuth)
# ==============================================================================

# Google OAuth Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================================================
# EMAIL SERVICES (Optional - for notifications)
# ==============================================================================

# SendGrid (Option 1)
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Generic SMTP (Option 2)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Notification Email
APPROVAL_EMAIL=notifications@yourdomain.com

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# Core Features
NEXT_PUBLIC_ENABLE_AI_CONSULTATION=true
NEXT_PUBLIC_ENABLE_AGENT_DASHBOARD=true
NEXT_PUBLIC_MEMORY_CONTEXT_ENABLED=true
NEXT_PUBLIC_MEMORY_AUTO_INJECT=true

# Beta Features (set to false for production)
NEXT_PUBLIC_ENABLE_TWEAKCC=false
NEXT_PUBLIC_ENABLE_CONTAINERS=false
NEXT_PUBLIC_ENABLE_BETA_ROUTE=false

# Advanced Features
ENABLE_CLI_PUPPETEER=false
ENABLE_MULTI_AI_DETECTION=false
ENABLE_UNIVERSAL_MEMORY=false

# ==============================================================================
# DEVELOPMENT SETTINGS (set to false for production)
# ==============================================================================

NEXT_TELEMETRY_DISABLED=1
CLI_PUPPETEER_DEBUG=false
CLI_PUPPETEER_LOG_LEVEL=info

# ==============================================================================
# GITHUB INTEGRATION (Optional)
# ==============================================================================

GITHUB_TOKEN=ghp_your-github-token
GITHUB_OWNER=your-github-username
GITHUB_REPO=coder1-ide

# ==============================================================================
# RENDER-SPECIFIC OPTIMIZATIONS
# ==============================================================================

# Memory Optimization for Render Standard Plan (512MB-1GB)
NODE_OPTIONS=--max-old-space-size=1500
MEMORY_PANIC_THRESHOLD_MB=1800

# Performance Settings
MAX_PARALLEL_AGENTS=3
MAX_WORKFLOW_TIME=300000
AGENT_RESPONSE_TIMEOUT=30000

# ==============================================================================
# SECURITY NOTES
# ==============================================================================

# 1. NEVER commit this file with real values to Git
# 2. Generate secure random strings for JWT secrets
# 3. Use environment-specific URLs for different deployments
# 4. Enable only features you need in production
# 5. Set appropriate memory limits for your hosting plan

# Generate JWT secrets with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"